# ---- Разработка на своём компьютере (достаточно этих строк) ----
DB_NAME=alpgroup
DB_USER=alpgroup
DB_PASSWORD=твой_пароль
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Сервер (docker compose, см. docs/DEPLOY.md) ----
# DB_HOST и DEBUG compose выставляет сам. Остальное задайте здесь.
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Адрес сайта без https://, например alp.example.com или 203-0-113-10.sslip.io
DOMAIN=
# 1: сайт по https (Caddy выпускает сертификат сам); 0: только http (куки без Secure)
HTTPS=1
# Дополнительно (через запятую), например для туннеля Cloudflare:
# ALLOWED_HOSTS=.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com

# ---- Показ через Cloudflare Tunnel со своего компьютера (docs/DEPLOY.md, «Быстрый показ») ----
# DB_NAME=alpgroup_demo
# DEBUG=0
# SECRET_KEY=сгенерированный_ключ
# SERVE_FILES=1          # статику и фото отдаёт Django (Caddy нет); на сервере не включать
# ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
# DEMO_USER=гость       # вход без пароля под гостем (только для показа, на сервере не включать)
