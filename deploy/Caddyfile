# Caddy: сам получает и продлевает сертификат Let's Encrypt для домена из .env (DOMAIN).
# Статику и фото отдаёт сам (из общих томов), остальное проксирует в Django.
{$DOMAIN} {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=3600"
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000
}
